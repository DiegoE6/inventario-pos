# Copia este archivo a .env.local y llena los valores. .env.local no se sube a git.
# En producción, estas mismas variables se configuran en Vercel.

# Supabase > Project Settings > Data API (o Connect) > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > Publishable key (empieza con sb_publishable_)
# Es pública por diseño: se usa en el navegador y RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
