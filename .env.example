# Copia este archivo a .env.local y llena los valores. .env.local no se sube a git.
# En producción, estas mismas variables se configuran en Vercel.

# Supabase > Project Settings > Data API (o Connect) > Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase > Project Settings > API Keys > Publishable key (empieza con sb_publishable_)
# Es pública por diseño: se usa en el navegador y RLS protege los datos.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Modo demo (solo servidor: NUNCA con prefijo NEXT_PUBLIC_) ---------------
# "true" muestra los botones "Entrar al demo" en el login y el banner del panel.
# Vacío o cualquier otro valor: instalación normal, sin nada de demo.
DEMO_MODE=
# Usuarios demo de Supabase (Authentication > Users). Las contraseñas se
# cambian con privado.cambiar_password_demo() (docs/sql/18-modo-demo.sql).
DEMO_DUENO_EMAIL=
DEMO_DUENO_PASSWORD=
DEMO_CAJERO_EMAIL=
DEMO_CAJERO_PASSWORD=

# --- Señal de vida (Vercel Cron, vercel.json) --------------------------------
# Opcional. Si existe, /api/vida solo responde a Vercel Cron, que manda
# "Authorization: Bearer <CRON_SECRET>". Texto aleatorio de 16+ caracteres.
CRON_SECRET=
